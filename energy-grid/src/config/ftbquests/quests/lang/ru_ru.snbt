{
  "chapter.6AC0E5D001000010.title": "Первый платёж",
  "quest.6AC0E5D001000011.title": "Первая продажа FE",
  "quest.6AC0E5D001000011.quest_desc": [
    "Возьмите из сундука углегенератор Powah!, три кабеля и уголь. Генератор поставьте на золото, кабели на оранжевые метки. ПКМ по генератору, уголь в топливный слот. Первые 4 000 FE принесут $1."
  ],
  "chapter.6AC0E5D001000020.title": "Станция окупается",
  "quest.6AC0E60000000011.title": "Купить на выручку",
  "quest.6AC0E60000000011.quest_desc": [
    "Откройте терминал → Магазин → Ресурсы острова. Получите уголь за $3. Пополните генератор и сравните выручку с расходами."
  ],
  "chapter.6AC0E5D001000030.title": "Склад сам заказывает топливо",
  "quest.6AC0E60000000021.title": "Первая поставка угля",
  "quest.6AC0E60000000021.quest_desc": [
    "Подойдите к стартовому сундуку. В разделе «Склад и тариф» нажмите «Предпросмотр», затем включите автозаказ. Оставьте меньше четырёх углей, свободное место и минимум $9 на счёте."
  ],
  "chapter.6AC0E5D001000040.title": "Накопители и рыночные тарифы",
  "quest.6AC0E60000000031.title": "Буфер станции",
  "quest.6AC0E60000000031.quest_desc": [
    "Купите начальный накопитель в отделе техники. Подключите генератор ко входу, выход к линии магнетита. Стороны задаются в окне накопителя."
  ],
  "quest.6AC0E60000000041.title": "Продажа в пик",
  "quest.6AC0E60000000041.quest_desc": [
    "Включите вечерний тариф и подайте энергию на счётчик от заката до полуночи. За 2 000 FE будет начислен $1."
  ],
  "chapter.6AC0E5D001000050.title": "Первый сервер",
  "quest.6AC0E60000000051.title": "Собрать серверную",
  "quest.6AC0E60000000051.quest_desc": [
    "Купите стойку хостинга и сборочный верстак. Используйте JEI для комплектующих. Установите собранный сервер в стойку, подведите питание и сеть."
  ],
  "quest.6AC0E60000000061.title": "Оплаченный заказ",
  "quest.6AC0E60000000061.quest_desc": [
    "В терминале выберите «Заказы стойки» и короткий заказ. Получите $1 выручки работающей стойки. Премия $2 зачисляется автоматически."
  ],
  "chapter.6AC0E5D001000060.title": "Собственное топливо",
  "quest.6AC0E60000000071.title": "Биотопливо",
  "quest.6AC0E60000000071.quest_desc": [
    "Подайте FE в дробитель Mekanism. Поместите в него семена или другую биомассу из списка применений JEI. Заберите биотопливо для биогенератора."
  ],
  "chapter.6AC0E5D001000070.title": "Промышленная сеть",
  "quest.6AC0E60000000081.title": "Ветровая линия",
  "quest.6AC0E60000000081.quest_desc": [
    "Купите или изготовьте ветрогенератор. Оставьте пространство для ротора, соедините выход с накопителем. Сверьте поток FE в интерфейсах машин."
  ],
  "quest.6AC0E60000000091.title": "Подготовка топлива",
  "quest.6AC0E60000000091.quest_desc": [
    "Соберите реакционную камеру. Найдите в JEI производственную цепь делящегося топлива. Закупите осмий, серу, уран и флюорит в отделе сырья."
  ],
  "chapter.6AC0E5D001000080.title": "Реактор и турбина",
  "quest.6AC0E600000000A1.title": "Запуск реактора деления",
  "quest.6AC0E600000000A1.quest_desc": [
    "После запуска щёлкните ПКМ по корпусу работающего реактора Mekanism. Для зачёта многоблок должен быть собран и сжигать топливо."
  ],
  "quest.6AC0E600000000B1.title": "Турбина под нагрузкой",
  "quest.6AC0E600000000B1.quest_desc": [
    "Подайте пар от реактора в клапан промышленной турбины. Откройте ПКМ корпус, пока турбина вырабатывает энергию. После приёмки островной счётчик пропускает до 100 000 FE/тик."
  ],
  "chapter.6AC0E5D001000090.title": "Автономная энергокомпания",
  "quest.6AC0E600000000C1.title": "Станция на самообеспечении",
  "quest.6AC0E600000000C1.quest_desc": [
    "Заработайте $1 000 на островном счётчике, получите десять автоматических поставок и выполните три заказа хостинга. Экспорт, склад и серверы используют один счёт Money."
  ],
  "chapter.6AC0E5D0010000A0.title": "Почему у меня ноль?",
  "quest.6AC0E600000000D1.title": "Проверка станции",
  "quest.6AC0E600000000D1.quest_desc": [
    "Счётчик стоит: проверьте уголь, выход генератора и три кабеля до магнетита. Деньги есть, угля нет: откройте предпросмотр, сравните запас, свободное место и денежный резерв. Стойка без дохода: проверьте питание, сеть, охлаждение и серверные слоты. Для премии требуется активный заказ."
  ],
  "quest.6AC0E69900000001.title": "Поздняя ветка: термоядерный синтез",
  "quest.6AC0E69900000001.quest_desc": [
    "Организуйте поставку дейтерия и трития. После зажигания откройте контроллер термоядерного реактора ПКМ. Сборка проверяет состояние плазмы."
  ],
  "quest.6AC0E69900000101.title": "Ветряк Immersive Engineering",
  "quest.6AC0E69900000101.quest_desc": [
    "Соберите ветряк на кинетическом динамо. Подключите выход динамо к линии. Цель засчитывается родным достижением Immersive Engineering."
  ],
  "quest.6AC0E69900000201.title": "Дизельная станция",
  "quest.6AC0E69900000201.quest_desc": [
    "Откройте в Руководстве инженера дизельный генератор. Соберите показанные слои и сформируйте многоблок инженерным молотом. Достижение мода подтверждает сборку."
  ],
  "quest.6AC0EF9900000021.title": "Хранилище заказчика",
  "quest.6AC0EF9900000021.quest_desc": [
    "Назначьте собственную стойку: Shift + ПКМ. Нужны активные диски от 30 ГБ, сеть и накопитель под стойкой с выходом вверх. В терминале примите заказ на 45 с и получите $12. При простое счётчик времени ждёт."
  ],
  "quest.6AC0EF9900000031.title": "Вычислительный заказ",
  "quest.6AC0EF9900000031.quest_desc": [
    "Установите 512 МБ ОЗУ или больше и запустите нагрузку. Принимайте заказ на 90 с при запасе 54 000 FE на работу сверх потребления стойки. Выплата $36."
  ]
}