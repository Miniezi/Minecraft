diff --git a/mod/src/main/java/dev/bunkerrelay/TrophyWeapons.java b/mod/src/main/java/dev/bunkerrelay/TrophyWeapons.java
new file mode 100644
index 0000000..9cb365c
--- /dev/null
+++ b/mod/src/main/java/dev/bunkerrelay/TrophyWeapons.java
@@ -0,0 +1,62 @@
+package dev.bunkerrelay;
+
+import com.tacz.guns.api.item.IGun;
+import com.tacz.guns.api.item.builder.AttachmentItemBuilder;
+import com.tacz.guns.api.item.builder.GunItemBuilder;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.network.chat.Component;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.component.CustomData;
+
+final class TrophyWeapons {
+    static int bonus(ItemStack stack) {
+        var data = stack.get(DataComponents.CUSTOM_DATA);
+        return data == null ? 0 : Math.clamp(data.copyTag().getInt("relay_trophy_damage"), 0, 14);
+    }
+
+    static void drop(LivingEntity source, String theme, int loot, boolean boss, String name) {
+        var level = (ServerLevel) source.level();
+        int tier = Math.clamp(loot, 1, 5);
+        int chance = boss ? 16 + 4 * tier : 4 + tier;
+        if (level.random.nextInt(100) >= chance) return;
+        var weapon = create(level, theme, boss, name, boss ? 8 + level.random.nextInt(7) : 3 + level.random.nextInt(5));
+        if (!weapon.isEmpty()) source.spawnAtLocation(weapon);
+    }
+
+    static ItemStack create(ServerLevel level, String theme, boolean boss, String name, int percent) {
+        String model = boss ? switch (theme) {
+            case "forest" -> "svd";
+            case "winter" -> "m700";
+            case "infected" -> "spas_12";
+            case "ash" -> "rpk";
+            case "hell" -> "scar_h";
+            default -> "hk416d";
+        } : switch (theme) {
+            case "forest" -> "glock_17";
+            case "infected" -> "m870";
+            case "ash" -> "ump45";
+            default -> "hk_mp5a5";
+        };
+        var stack = GunItemBuilder.create().setId(id(model)).setAmmoCount(0).build(level.registryAccess());
+        if (!(stack.getItem() instanceof IGun gun)) return ItemStack.EMPTY;
+        String[] modules = {"scope_pso_1","sight_t2","scope_mk5hd","muzzle_choke_sg","light_extended_mag_1","extended_mag_2","laser_peq15"};
+        int installed = 0;
+        for (String attachment : modules) {
+            var module = AttachmentItemBuilder.create().setId(id(attachment)).build();
+            if (!gun.allowAttachment(stack, module)) continue;
+            var type = ((com.tacz.guns.api.item.IAttachment) module.getItem()).getType(module);
+            if (gun.getAttachmentTag(stack,type) != null) continue;
+            gun.installAttachment(level.registryAccess(),stack,module);
+            if (++installed == (boss ? 2 : 1)) break;
+        }
+        CustomData.update(DataComponents.CUSTOM_DATA,stack,tag -> tag.putInt("relay_trophy_damage",percent));
+        stack.set(DataComponents.CUSTOM_NAME,Component.literal(name + " · " + model.toUpperCase(java.util.Locale.ROOT) + " · +" + percent + "% урона"));
+        return stack;
+    }
+
+    private static ResourceLocation id(String path) { return ResourceLocation.fromNamespaceAndPath("tacz",path); }
+    private TrophyWeapons() {}
+}
