@@ -0,0 +1,30 @@
+package dev.bunkerrelay;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.level.block.Blocks;
+
+final class CrossingIntegrationTest {
+    static void verify(MinecraftServer server) {
+        var world=server.getLevel(BunkerRelay.key("city"));
+        var sample=new RelayState();
+        sample.activeSize=2048;
+        sample.activeTheme="industrial";
+        // Two elevated quays, the reserved 32-block gap, a low wall and a sloping landing.
+        var middle=new BlockPos(96,world.getMaxBuildHeight()-15,40);
+        for(int i=-17;i<=17;i++)for(int k=-2;k<=2;k++){
+            var at=middle.offset(i,0,k);
+            world.getChunkAt(at);
+            if(Math.abs(i)==17)world.setBlock(at.above(i>0?4:0),Blocks.WHITE_CONCRETE.defaultBlockState(),2);
+            else world.setBlock(at.below(6),Blocks.WATER.defaultBlockState(),2);
+        }
+        world.setBlock(middle.west(17).above(),Blocks.STONE_BRICK_WALL.defaultBlockState(),2);
+        SectorCrossings.visit(world,sample,middle);
+        for(int i=-17;i<=17;i++)for(int k=-2;k<=2;k++){
+            var deck=middle.offset(i,Math.round((i+17)*4f/34),k);
+            if(!world.getBlockState(deck).is(k==0?Blocks.LIGHT_GRAY_CONCRETE:Blocks.SMOOTH_STONE)
+                ||!world.isEmptyBlock(deck.above()))throw new IllegalStateException("Broken crossing "+deck);
+        }
+        System.out.println("RELAY_052_BRIDGE_PASS");
+    }
+    private CrossingIntegrationTest(){}
+}
