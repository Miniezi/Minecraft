@@ -0,0 +1,91 @@
+package dev.bunkerrelay;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+
+/** Optional jobs exist only on successfully placed expedition structures. */
+final class FieldJobs {
+    private enum Job {
+        PHARMACY("Опись санитарного резерва",Items.GOLDEN_APPLE,145),
+        WORKSHOP("Сверка заводского заказа",Items.REDSTONE_BLOCK,125),
+        ARMORY("Поиск накладной на оружие",Items.IRON_INGOT,150),
+        STORE("Розыск партии снабжения",Items.EXPERIENCE_BOTTLE,110);
+        final String title;
+        final Item reward;
+        final int credits;
+        Job(String title,Item reward,int credits){this.title=title;this.reward=reward;this.credits=credits;}
+    }
+
+    static void assign(CompoundTag room,ZoneLandmarks.Plan plan,RelayState state){
+        if(Math.floorMod(RaidDirector.roll(state.seed,room.getInt("x"),room.getInt("z")),4)!=0)return;
+        Job job=plan.medical()?Job.PHARMACY:switch(plan.loot()){
+            case FACTORY->Job.WORKSHOP;case ARMORY->Job.ARMORY;default->Job.STORE;
+        };
+        room.putString("fieldJob",job.name());
+    }
+
+    private static CompoundTag progress(ServerPlayer player,RelayState state){
+        var account=RelayEconomy.account(player);
+        var jobs=account.getCompound("fieldJobs");
+        if(!jobs.contains("seed")||jobs.getLong("seed")!=state.seed){
+            jobs=new CompoundTag();jobs.putLong("seed",state.seed);account.put("fieldJobs",jobs);
+        }
+        return jobs;
+    }
+
+    static void notice(ServerPlayer player,RelayState state,CompoundTag room){
+        if(!room.contains("fieldJob"))return;
+        var jobs=progress(player,state);
+        String key=Long.toString(room.getLong("origin"));
+        if(jobs.contains(key))return;
+        jobs.putInt(key,1);
+        var job=Job.valueOf(room.getString("fieldJob"));
+        RaidRules.chat(player,job.title+" · "+room.getString("title")+" · осмотрите шкаф "+BlockPos.of(room.getLong("cabinet")).toShortString()+" · "+job.credits+" кр. и припасы");
+    }
+
+    static void report(ServerPlayer player,RelayState state){
+        if(!RaidRules.active(player))return;
+        var jobs=progress(player,state);
+        for(var room:RaidDirector.get(player.server).rooms){
+            if(!room.contains("fieldJob"))continue;
+            int step=jobs.getInt(Long.toString(room.getLong("origin")));
+            if(step!=1&&step!=2)continue;
+            var at=step==1?BlockPos.of(room.getLong("cabinet")):new BlockPos(room.getInt("x"),room.getInt("y"),room.getInt("z"));
+            RaidRules.chat(player,Job.valueOf(room.getString("fieldJob")).title+" · "+room.getString("title")+(step==1?" · осмотрите шкаф ":" · проверьте груз ")+at.toShortString());
+        }
+    }
+
+    static void interact(ServerPlayer player,RelayState state,BlockPos pos){
+        if(!state.ready||state.generating||!RaidRules.active(player))return;
+        for(var room:RaidDirector.get(player.server).rooms){
+            if(!room.contains("fieldJob"))continue;
+            var cache=new BlockPos(room.getInt("x"),room.getInt("y"),room.getInt("z"));
+            boolean cabinet=room.getLong("cabinet")==pos.asLong();
+            if(!cabinet&&!cache.equals(pos))continue;
+            notice(player,state,room);
+            var jobs=progress(player,state);
+            String key=Long.toString(room.getLong("origin"));
+            var job=Job.valueOf(room.getString("fieldJob"));
+            if(cabinet&&jobs.getInt(key)==1){
+                jobs.putInt(key,2);RaidRules.chat(player,"Запись найдена. Сверьте груз в ящике "+cache.toShortString());
+            }else if(cache.equals(pos)&&jobs.getInt(key)==2){
+                var reward=new ItemStack(job.reward,job==Job.PHARMACY?1:3);
+                if(SafeInventory.capacity(player.getInventory(),reward)<reward.getCount()){
+                    RaidRules.tell(player,"Освободите место для награды и снова откройте ящик.");return;
+                }
+                var account=RelayEconomy.account(player);
+                long paid=Math.min(job.credits,RelayEconomy.MAX_BALANCE-RelayEconomy.balance(player));
+                jobs.putInt(key,3);
+                SafeInventory.insert(player.getInventory(),reward);
+                account.putLong("balance",RelayEconomy.balance(player)+paid);RelayEconomy.save(player);
+                RaidRules.chat(player,job.title+" · выполнено, получено "+paid+" кр. и припасы");
+            }
+            return;
+        }
+    }
+    private FieldJobs(){}
+}
