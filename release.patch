@@ -0,0 +1,56 @@
+package dev.bunkerrelay;
+
+import java.util.WeakHashMap;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.*;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.inventory.ChestMenu;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.context.UseOnContext;
+import net.neoforged.neoforge.event.entity.player.PlayerInteractEvent;
+
+final class CargoBike extends Item {
+    static final java.util.function.Supplier<Item> ITEM=BossTrophies.ITEMS.register("cargo_bike",CargoBike::new);
+    static final WeakHashMap<Entity,SimpleContainer> bags=new WeakHashMap<>();
+    CargoBike(){super(new Item.Properties().stacksTo(1));}
+    static void register(){}
+    @Override public InteractionResult useOn(UseOnContext c){
+        var level=c.getLevel();if(level.isClientSide)return InteractionResult.SUCCESS;
+        var at=c.getClickedPos().relative(c.getClickedFace());
+        var bike=BuiltInRegistries.ENTITY_TYPE.get(ResourceLocation.parse("simplebikes:basic_bike")).create(level);
+        if(bike==null)return InteractionResult.FAIL;
+        bike.moveTo(at.getX()+.5,at.getY(),at.getZ()+.5);
+        if(!level.noCollision(bike))return InteractionResult.FAIL;
+        bike.addTag("relay_cargo_bike");bike.setCustomName(Component.literal("Грузовой велосипед"));
+        if(!level.addFreshEntity(bike))return InteractionResult.FAIL;
+        if(c.getPlayer()==null||!c.getPlayer().getAbilities().instabuild)c.getItemInHand().shrink(1);
+        return InteractionResult.CONSUME;
+    }
+    static SimpleContainer bag(Entity bike){
+        return bags.computeIfAbsent(bike,key->{
+            var box=new SimpleContainer(9);
+            box.fromTag(key.getPersistentData().getList("relayPannier",10),key.registryAccess());
+            var ref=new java.lang.ref.WeakReference<>(key);
+            box.addListener(c->{var e=ref.get();if(e!=null)e.getPersistentData().put("relayPannier",box.createTag(e.registryAccess()));});
+            return box;
+        });
+    }
+    static void open(PlayerInteractEvent.EntityInteract e){
+        if(!e.getTarget().getTags().contains("relay_cargo_bike")||!e.getEntity().isShiftKeyDown())return;
+        e.setCanceled(true);e.setCancellationResult(InteractionResult.SUCCESS);
+        if(e.getHand()==InteractionHand.MAIN_HAND&&e.getEntity() instanceof ServerPlayer p){
+            var bike=e.getTarget();var box=bag(bike);
+            p.openMenu(new SimpleMenuProvider((i,inv,owner)->new ChestMenu(net.minecraft.world.inventory.MenuType.GENERIC_9x1,i,inv,box,1){
+                @Override public boolean stillValid(net.minecraft.world.entity.player.Player who){return bike.isAlive()&&who.distanceToSqr(bike)<64;}
+            },Component.literal("Велосипед · багажник")));
+        }
+    }
+    static void unload(net.neoforged.neoforge.event.entity.EntityLeaveLevelEvent e){
+        var bike=e.getEntity();if(!e.getLevel().isClientSide()&&bike.getTags().contains("relay_cargo_bike")&&bike.getRemovalReason()!=null&&bike.getRemovalReason().shouldDestroy()){
+            for(var stack:bag(bike).removeAllItems())bike.spawnAtLocation(stack);
+        }
+    }
+}
