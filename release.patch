diff --git a/tools/expand_lock.py b/tools/expand_lock.py
new file mode 100644
index 0000000..bf47f75
--- /dev/null
+++ b/tools/expand_lock.py
@@ -0,0 +1,32 @@
+"""Resolve new release dependencies once, preserving all existing pins."""
+import json, urllib.request, urllib.parse
+from pathlib import Path
+from resolve_pack import ROOT, main as index
+path=ROOT/'pack.lock.json'
+lock=json.loads(path.read_text())
+known={m['project_id']:m for m in lock['mods']}
+def get(endpoint):
+    req=urllib.request.Request('https://api.modrinth.com/v2/'+endpoint,headers={'User-Agent':'BunkerRelay/release-builder'})
+    with urllib.request.urlopen(req,timeout=45) as response:return json.load(response)
+def add(project,version=None):
+    p=get('project/'+project)
+    if p['id'] in known:
+        if version and known[p['id']]['version_id']!=version:raise ValueError('Version conflict: '+project)
+        return
+    query=urllib.parse.urlencode({'loaders':'["neoforge"]','game_versions':'["1.21.1"]'})
+    vs=[get('version/'+version)] if version else get('project/'+p['id']+'/version?'+query)
+    vs.sort(key=lambda v:(v['version_type']=='release',v['date_published']),reverse=True)
+    v=vs[0]
+    if '1.21.1' not in v['game_versions'] or 'neoforge' not in v['loaders']:raise ValueError(project)
+    f=next((f for f in v['files'] if f['primary']),v['files'][0])
+    env={'client':p['client_side'],'server':p['server_side']}
+    entry=dict(slug=p['slug'],title=p['title'],version=v['version_number'],version_id=v['id'],project_id=p['id'],dependencies=v['dependencies'],env=env,url='https://modrinth.com/mod/'+p['slug'],file={'path':'mods/'+f['filename'],'hashes':f['hashes'],'env':env,'downloads':[f['url']],'fileSize':f['size']})
+    known[p['id']]=entry
+    lock['mods'].append(entry)
+    print('Selected',p['slug'],v['version_number'],flush=True)
+    for dep in v['dependencies']:
+        if dep['dependency_type']=='required':add(dep['project_id'],dep['version_id'])
+if __name__=='__main__':
+    for project in ['skateboard-mod','cybernetic-system']:add(project)
+    path.write_text(json.dumps(lock,indent=2,ensure_ascii=False)+'\n')
+    index()
