diff --git a/mod/src/main/java/dev/bunkerrelay/ExpeditionMine.java b/mod/src/main/java/dev/bunkerrelay/ExpeditionMine.java
new file mode 100644
index 0000000..fbc3011
--- /dev/null
+++ b/mod/src/main/java/dev/bunkerrelay/ExpeditionMine.java
@@ -0,0 +1,124 @@
+package dev.bunkerrelay;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Random;
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.Blocks;
+
+/** A connected network of chambers generated in bounded steps on its own expedition plot. */
+final class ExpeditionMine {
+    static final int SIDE=9, ROOMS=SIDE*SIDE;
+    private final int[] links=new int[ROOMS];
+    private static final int[] DX={0,1,0,-1}, DZ={-1,0,1,0};
+    private final BlockPos center;
+    private final String theme;
+    private final long seed;
+    private final Block rock;
+    private int room;
+
+    ExpeditionMine(ServerLevel level,RelayState state){
+        theme=state.activeTheme;
+        seed=state.seed;
+        var plot=ExpeditionGrid.point(state,ExpeditionGrid.PLOTS-1);
+        center=plot.atY(level.getMinBuildHeight()+20);
+        rock=switch(theme){case "hell"->Blocks.BLACKSTONE;case "winter"->Blocks.TUFF;
+            case "forest"->Blocks.STONE;case "infected"->Blocks.CALCITE;case "ash"->Blocks.BASALT;default->Blocks.DEEPSLATE;};
+        var rng=new Random(seed ^ plot.asLong());
+        var visited=new boolean[ROOMS];
+        connect(ROOMS/2,visited,rng);
+        for(int i=0;i<ROOMS;i++)if(i%SIDE<SIDE-1&&rng.nextInt(7)==0)link(i,1,i+1);
+    }
+
+    private void link(int a,int dir,int b){links[a]|=1<<dir;links[b]|=1<<((dir+2)%4);}
+    private void connect(int cell,boolean[] seen,Random rng){
+        seen[cell]=true;
+        var directions=new ArrayList<>(java.util.List.of(0,1,2,3));
+        Collections.shuffle(directions,rng);
+        for(int dir:directions){
+            int x=cell%SIDE+DX[dir],z=cell/SIDE+DZ[dir];
+            if(x<0||x>=SIDE||z<0||z>=SIDE)continue;
+            int next=x+SIDE*z;
+            if(!seen[next]){link(cell,dir,next);connect(next,seen,rng);}
+        }
+    }
+
+    static String title(String theme){return switch(theme){
+        case "forest"->"Лесной железный рудник";case "winter"->"Ледяные копи";case "ash"->"Обгоревшие штольни";
+        case "infected"->"Карантинные выработки";case "hell"->"Глубинные копи разлома";default->"Промышленный рудник";};}
+
+    boolean step(ServerLevel level,RelayState state){
+        if(room<ROOMS){carve(level,room++);return false;}
+        int y=StructureLevels.floor(level,state,"mine",center.getX(),center.getZ(),3,4,6);
+        var gate=center.atY(y);
+        for(int x:new int[]{-2,2})for(int h=0;h<4;h++)set(level,gate.offset(x,h,0),Blocks.STRIPPED_SPRUCE_LOG);
+        for(int x=-2;x<=2;x++)set(level,gate.offset(x,3,0),Blocks.DARK_OAK_PLANKS);
+        set(level,gate.above(2),Blocks.LANTERN);
+        set(level,gate.below(),Blocks.CUT_COPPER);
+        set(level,center.below(),Blocks.CUT_COPPER);
+        set(level,center.north(2).below(),Blocks.SHROOMLIGHT);
+        // A winding surface fissure beside the entrance, with a shallow way out at either end.
+        for(int i=-16;i<=16;i++){
+            int z=center.getZ()+13+(int)Math.round(3*Math.sin(i*.22+(seed&7)));
+            int depth=Math.min(7,1+(16-Math.abs(i))/2);
+            for(int w=-1;w<=1;w++){
+                int x=center.getX()+i,top=SurfacePlacement.ground(level,x,z+w);
+                for(int h=1;h<=depth-Math.abs(w);h++)set(level,new BlockPos(x,top-h,z+w),Blocks.AIR);
+            }
+        }
+        state.fieldRoutes.putLong("mineGate",gate.asLong());state.fieldRoutes.putLong("mineReturn",center.asLong());state.setDirty();
+        return true;
+    }
+
+    private Block ore(Random random){
+        int roll=random.nextInt(100);
+        return switch(theme){
+            case "hell"->roll<3?Blocks.ANCIENT_DEBRIS:roll<12?Blocks.DIAMOND_ORE:roll<45?Blocks.NETHER_GOLD_ORE:Blocks.NETHER_QUARTZ_ORE;
+            case "winter"->roll<25?Blocks.LAPIS_ORE:roll<65?Blocks.IRON_ORE:Blocks.COPPER_ORE;
+            case "industrial"->roll<35?Blocks.REDSTONE_ORE:roll<70?Blocks.IRON_ORE:Blocks.COPPER_ORE;
+            case "infected"->roll<22?Blocks.GOLD_ORE:roll<58?Blocks.REDSTONE_ORE:Blocks.IRON_ORE;
+            case "ash"->roll<8?Blocks.EMERALD_ORE:roll<48?Blocks.GOLD_ORE:Blocks.IRON_ORE;
+            default->roll<25?Blocks.IRON_ORE:roll<60?Blocks.COPPER_ORE:Blocks.COAL_ORE;
+        };
+    }
+
+    private void carve(ServerLevel level,int index){
+        var at=center.offset((index%SIDE-SIDE/2)*9,0,(index/SIDE-SIDE/2)*9);
+        var rng=new Random(RaidDirector.roll(seed,index,651));
+        int radius=2+rng.nextInt(2),height=3+rng.nextInt(3);
+        Block vein=ore(rng);
+        if(theme.equals("hell")&&index==Math.floorMod(seed,ROOMS))vein=Blocks.ANCIENT_DEBRIS;
+        if(theme.equals("hell")&&index==Math.floorMod(seed+1,ROOMS))vein=Blocks.DIAMOND_ORE;
+        for(int x=-4;x<=4;x++)for(int z=-4;z<=4;z++){
+            boolean hall=(Math.abs(x)<=1&&((z<0&&(links[index]&1)!=0)||(z>0&&(links[index]&4)!=0)))
+                ||(Math.abs(z)<=1&&((x>0&&(links[index]&2)!=0)||(x<0&&(links[index]&8)!=0)));
+            boolean cave=x*x+z*z<=radius*radius+1;
+            int clearance=cave?height-(Math.abs(x)+Math.abs(z))/3:hall?3:0;
+            for(int y=-1;y<=height;y++){
+                Block b=y>=0&&y<clearance?Blocks.CAVE_AIR:rock;
+                if(b==rock&&y==0&&z==-radius&&Math.abs(x)<=1)b=vein;
+                if(b==rock&&y==1&&z==-radius-1&&Math.abs(x)<=1)b=vein;
+                if(y==-1&&theme.equals("winter")&&index%4==1)b=Blocks.PACKED_ICE;
+                if(y==-1&&theme.equals("hell")&&index%6==2)b=Blocks.SOUL_SOIL;
+                set(level,at.offset(x,y,z),b);
+            }
+        }
+        if(index%6==0)set(level,at.above(height-1),Blocks.SHROOMLIGHT);
+    }
+    private static void set(ServerLevel level,BlockPos p,Block block){level.setBlock(p,block.defaultBlockState(),2);}
+
+    static void walk(ServerPlayer p,RelayState s){
+        if(!s.ready||s.generating||!RaidRules.active(p)||!s.fieldRoutes.contains("mineGate"))return;
+        var gate=BlockPos.of(s.fieldRoutes.getLong("mineGate"));var back=BlockPos.of(s.fieldRoutes.getLong("mineReturn"));
+        var feet=p.blockPosition();
+        boolean enter=feet.equals(gate);
+        if(!enter&&!feet.equals(back))return;
+        var to=(enter?back:gate).south(2);
+        p.moveTo(to.getX()+.5,to.getY(),to.getZ()+.5,p.getYRot(),p.getXRot());
+        p.connection.teleport(to.getX()+.5,to.getY(),to.getZ()+.5,p.getYRot(),p.getXRot());
+        p.fallDistance=0;RaidRules.tell(p,enter?title(s.activeTheme)+" · выход у освещённой медной плиты":"Вы у входа в шахту");
+    }
+}
