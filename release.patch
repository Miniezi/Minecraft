diff --git a/mod/src/main/java/dev/bunkerrelay/InteriorSites.java b/mod/src/main/java/dev/bunkerrelay/InteriorSites.java
new file mode 100644
index 0000000..2c35a9b
--- /dev/null
+++ b/mod/src/main/java/dev/bunkerrelay/InteriorSites.java
@@ -0,0 +1,79 @@
+package dev.bunkerrelay;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.entity.ChestBlockEntity;
+
+/** A walk-in vestibule leads to the interior underneath its own reserved plot. */
+final class InteriorSites {
+    static void prepare(ServerLevel level, RelayState state, CompoundTag room, BlockPos origin, BlockPos approach) {
+        String theme=switch(room.getString("template")){
+            case "hospital" -> "hospital";
+            case "military_camp" -> "military";
+            case "cell" -> "bunker";
+            default -> "";
+        };
+        if(theme.isEmpty())return;
+        int floorY=level.getMinBuildHeight()+8;
+        // Old flat expedition worlds may have no usable depth below their structures.
+        if(origin.getY()-floorY<40)floorY=level.getMaxBuildHeight()-12;
+        var inside=origin.atY(floorY);
+        var gate=approach.offset(Integer.signum(origin.getX()-approach.getX())*2,0,Integer.signum(origin.getZ()-approach.getZ())*2);
+        room.putLong("insideGate",gate.asLong());
+        room.putLong("insideFloor",inside.asLong());
+        level.setBlock(gate.below(),Blocks.OXIDIZED_COPPER.defaultBlockState(),2);
+        var wall=switch(theme){case "hospital"->Blocks.WHITE_CONCRETE;case "military"->Blocks.GREEN_TERRACOTTA;default->Blocks.DEEPSLATE_BRICKS;};
+        int wings=theme.equals("military")?4:theme.equals("hospital")?3:2;
+        int depth=8*wings+3;
+        for(int x=-14;x<=14;x++)for(int z=0;z<=depth;z++)for(int y=-1;y<=4;y++){
+            boolean edge=Math.abs(x)==14||z==0||z==depth;
+            boolean partition=(Math.abs(x)==3 && z%8!=4)||(Math.abs(x)>3 && z%8==0);
+            var block=y==-1?Blocks.SMOOTH_STONE:y==4?(x==0&&z%4==0?Blocks.SEA_LANTERN:wall):edge||partition?wall:Blocks.AIR;
+            level.setBlock(inside.offset(x,y,z),block.defaultBlockState(),2);
+        }
+        level.setBlock(inside.offset(0,-1,1),Blocks.OXIDIZED_COPPER.defaultBlockState(),2);
+        for(int wing=0;wing<wings;wing++)for(int side:new int[]{-1,1}){
+            var at=inside.offset(11*side,0,4+wing*8);
+            level.setBlock(at,Blocks.CHEST.defaultBlockState(),3);
+            if(!(level.getBlockEntity(at) instanceof ChestBlockEntity chest))continue;
+            var rng=net.minecraft.util.RandomSource.create(state.seed^at.asLong());
+            if(theme.equals("hospital")){
+                chest.setItem(1,new ItemStack(Medicine.BANDAGE.get(),2+rng.nextInt(6)));
+                chest.setItem(7,side>0?new ItemStack(Medicine.MEDKIT.get()):new ItemStack(Items.HONEY_BOTTLE));
+                level.setBlock(at.east(),Blocks.WHITE_WOOL.defaultBlockState(),2);
+            }else if(theme.equals("military")){
+                RaidLoot.specialist(chest,level,state,at,SupplySites.Kind.ARMORY);
+                chest.setItem(15,new ItemStack(wing%2==0?Items.IRON_HELMET:Items.IRON_CHESTPLATE));
+                level.setBlock(at.east(),Blocks.SMITHING_TABLE.defaultBlockState(),2);
+            }else{
+                RaidLoot.specialist(chest,level,state,at,side>0?SupplySites.Kind.WAREHOUSE:SupplySites.Kind.CANTEEN);
+                level.setBlock(at.east(),Blocks.CRAFTING_TABLE.defaultBlockState(),2);
+            }
+            PersonalLoot.convert(level,at,chest);
+        }
+    }
+
+    static void walk(ServerPlayer player,RelayState state){
+        if(!state.ready||state.generating||!RaidRules.active(player))return;
+        var feet=player.blockPosition();
+        if(!player.level().getBlockState(feet.below()).is(Blocks.OXIDIZED_COPPER))return;
+        for(var room:RaidDirector.get(player.server).rooms){
+            if(!room.contains("insideGate"))continue;
+            var gate=BlockPos.of(room.getLong("insideGate"));
+            var inside=BlockPos.of(room.getLong("insideFloor"));
+            BlockPos destination;
+            if(feet.equals(gate))destination=inside.south(3);
+            else if(feet.equals(inside.south()))destination=BlockPos.of(room.getLong("approach"));
+            else continue;
+            player.moveTo(destination.getX()+0.5,destination.getY(),destination.getZ()+0.5,player.getYRot(),player.getXRot()); player.connection.teleport(player.getX(),player.getY(),player.getZ(),player.getYRot(),player.getXRot()); player.fallDistance=0;
+            RaidRules.tell(player,feet.equals(gate)?room.getString("title")+" · для выхода вернитесь на медную плиту":"Вы вернулись на улицу.");
+            return;
+        }
+    }
+    private InteriorSites(){}
+}
