diff --git a/tools/progression_recipes.py b/tools/progression_recipes.py
new file mode 100644
index 0000000..8d8d4f2
--- /dev/null
+++ b/tools/progression_recipes.py
@@ -0,0 +1,63 @@
+"""Gate existing suit/implant crafting recipes while retaining their original machinery and ingredients."""
+import json, hashlib, io, urllib.request, zipfile, re
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+lock=json.loads((ROOT/'pack.lock.json').read_text())['mods']
+for slug in ['mekanism','cybernetic-system']:
+    mod=next(m for m in lock if m['slug']==slug)
+    f=mod['file']
+    raw=urllib.request.urlopen(f['downloads'][0],timeout=100).read()
+    assert hashlib.sha512(raw).hexdigest()==f['hashes']['sha512']
+    with zipfile.ZipFile(io.BytesIO(raw)) as jar:
+        changed=0
+        for path in jar.namelist():
+            if not re.fullmatch(r'data/[^/]+/recipe/.*\.json',path):continue
+            obj=json.loads(jar.read(path))
+            result=obj.get('result',{})
+            if not isinstance(result,dict):continue
+            item=result.get('id','')
+            if not isinstance(item,str):continue
+            mech='mekasuit' in item
+            upgrade=any(k in item for k in ('implant','helmet','chestplate','leggings','boots','exoskeleton','chip','circuit','processor','glasses','scanner','cyborg'))
+            if not (mech or (slug=='cybernetic-system' and upgrade)):continue
+            extra={'item':'minecraft:netherite_ingot' if mech else 'minecraft:blaze_rod'}
+            if mech and 'key' in obj:
+                cell=next((k for k,v in obj['key'].items() if v=={'item':'mekanism:basic_induction_cell'}),None)
+                if not cell:continue
+                obj['key'][cell]={'item':'bunkerrelay:exo_cell'}
+            elif obj.get('type')=='minecraft:crafting_shaped':
+                rows=obj['pattern']
+                hole=next(((y,x) for y,row in enumerate(rows) for x,c in enumerate(row) if c==' '),None)
+                if hole is None and len(rows)<3:
+                    rows.append(' '*len(rows[0]));hole=(len(rows)-1,0)
+                if hole is None:
+                    # Full grids already consume nine slots. Upgrade one base metal.
+                    key=next((k for k,v in obj['key'].items() if isinstance(v,dict) and v.get('item') in ('minecraft:iron_ingot','minecraft:diamond','minecraft:gold_ingot')),None)
+                    if not key:continue
+                    obj['key'][key]=extra
+                else:
+                    key=next(c for c in 'XYZQJK' if c not in obj['key'])
+                    y,x=hole;rows[y]=rows[y][:x]+key+rows[y][x+1:];obj['key'][key]=extra
+            elif obj.get('type')=='minecraft:crafting_shapeless' and len(obj['ingredients'])<9:obj['ingredients'].append(extra)
+            else:continue
+            dest=ROOT/'mod/src/main/resources'/path
+            dest.parent.mkdir(parents=True,exist_ok=True);dest.write_text(json.dumps(obj,indent=2)+'\n')
+            changed+=1
+        if slug=='cybernetic-system':
+            # Keep the external mod's surgery/workstations. Offer a salvage-based route
+            # for a small selection of its registered components at the Relay workbench.
+            models=sorted(path for path in jar.namelist() if re.fullmatch(r'assets/[^/]+/models/item/[^/]+\.json',path))
+            candidates=[path for path in models if any(part in path.lower() for part in ('chip','implant','processor','circuit'))]
+            for i,path in enumerate(candidates[:4]):
+                parts=path.split('/')
+                name=parts[-1][:-5]
+                result_id=parts[1]+':'+name
+                recipe={'type':'minecraft:crafting_shapeless','ingredients':[{'item':v} for v in
+                    ('create:precision_mechanism','minecraft:blaze_rod','minecraft:netherite_scrap','bunkerrelay:exo_cell')]+
+                    [{'item':'minecraft:redstone'}]*(i+1),'result':{'id':result_id}}
+                dest=ROOT/'mod/src/main/resources/data/bunkerrelay/recipe'/('salvage_'+name+'.json')
+                dest.write_text(json.dumps(recipe,indent=2)+'\n')
+                changed+=1
+            print('Cyber implant components:',[p.split('/')[-1] for p in candidates[:4]],flush=True)
+        if slug=='mekanism' and changed<4:raise ValueError('Expected four modified MekaSuit recipes: '+str(changed))
+        print('Progression recipes:',slug,changed,flush=True)
