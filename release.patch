diff --git a/mod/src/main/java/dev/bunkerrelay/SectorCrossings.java b/mod/src/main/java/dev/bunkerrelay/SectorCrossings.java
new file mode 100644
index 0000000..6bf896a
--- /dev/null
+++ b/mod/src/main/java/dev/bunkerrelay/SectorCrossings.java
@@ -0,0 +1,138 @@
+package dev.bunkerrelay;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.levelgen.Heightmap;
+
+/** Join opposite banks of the two reserved chunks at a city parcel boundary. */
+final class SectorCrossings {
+    private static final int BANK = 17;
+    private static final int WIDTH = 2;
+
+    static void visit(ServerLevel level, RelayState state, BlockPos player) {
+        trailSpans(level,state,player);
+        if (!java.util.Set.of("industrial","infected","ash").contains(state.activeTheme)) return;
+        for (Direction axis : new Direction[]{Direction.EAST, Direction.SOUTH}) {
+            boolean east = axis == Direction.EAST;
+            int origin = east ? state.centerX : state.centerZ;
+            int normal = east ? player.getX() : player.getZ();
+            int along = east ? player.getZ() : player.getX();
+            int boundary = origin + Math.floorDiv(normal-origin, ExpeditionGrid.SIDE)*ExpeditionGrid.SIDE + ExpeditionGrid.HALF;
+            if (Math.abs(boundary-normal)>48) continue;
+            // Lost Cities street centres are aligned to chunks.
+            int first = Math.floorDiv(along-32,16)*16+8;
+            for (int lane=first;lane<=along+32;lane+=16) {
+                BlockPos middle = new BlockPos(east?boundary:lane,0,east?lane:boundary);
+                if (!SectorPlan.contains(state.centerX,state.centerZ,state.activeSize,middle.getX()-BANK,middle.getZ()-BANK)
+                    || !SectorPlan.contains(state.centerX,state.centerZ,state.activeSize,middle.getX()+BANK,middle.getZ()+BANK)) continue;
+                String key="bridge52/"+level.dimension().location()+"/"+middle.asLong()+"/"+axis;
+                if (!state.roadChunks.contains(key) && build(level,state,middle,axis)) {
+                    state.roadChunks.putBoolean(key,true);
+                    state.setDirty();
+                }
+            }
+        }
+    }
+
+    // A crossing along the grid road can also be needed away from a city boundary.
+    private static void trailSpans(ServerLevel level,RelayState state,BlockPos player){
+        for(Direction axis:new Direction[]{Direction.EAST,Direction.SOUTH}){
+            boolean east=axis==Direction.EAST;
+            int normal=east?player.getZ():player.getX();
+            int origin=east?state.centerZ:state.centerX;
+            int line=origin+Math.floorDiv(normal-origin,ExpeditionGrid.SIDE)*ExpeditionGrid.SIDE+ExpeditionGrid.HALF;
+            if(Math.abs(line-normal)>20)continue;
+            var here=east?new BlockPos(player.getX(),0,line):new BlockPos(line,0,player.getZ());
+            for(int n=-20;n<=20;n++){
+                var bank=here.relative(axis,n);
+                var next=bank.relative(axis);
+                if(!level.hasChunkAt(bank)||!level.hasChunkAt(next))continue;
+                int h=height(level,bank);
+                if(!land(level,bank.atY(h)))continue;
+                int low=height(level,next);
+                if(low>h-3 && level.getFluidState(next.atY(low)).isEmpty())continue;
+                for(int span=2;span<=48;span++){
+                    var end=bank.relative(axis,span);
+                    if(!level.hasChunkAt(end))break;
+                    int y=height(level,end);
+                    if(!land(level,end.atY(y))||y<h-3)continue;
+                    if(Math.abs(h-y)<=span/2 && SectorPlan.contains(state.centerX,state.centerZ,state.activeSize,bank.getX(),bank.getZ())
+                        && SectorPlan.contains(state.centerX,state.centerZ,state.activeSize,end.getX(),end.getZ()))
+                        trailDeck(level,state,bank,axis,span,h,y);
+                    break;
+                }
+            }
+        }
+    }
+
+    private static boolean land(ServerLevel level,BlockPos at){
+        var s=level.getBlockState(at);
+        return s.is(net.minecraft.tags.BlockTags.DIRT)||s.is(Blocks.DIRT_PATH)||s.is(Blocks.GRAVEL)
+            ||s.is(Blocks.SAND)||s.is(Blocks.STONE)||s.is(Blocks.ANDESITE)||s.is(Blocks.COBBLED_DEEPSLATE);
+    }
+
+    private static void trailDeck(ServerLevel level,RelayState state,BlockPos bank,Direction axis,int span,int from,int to){
+        var side=axis.getClockWise();
+        int deckStart=from;
+        for(int pass=0;pass<2;pass++)for(int i=0;i<=span;i++){
+            var at=bank.relative(axis,i).atY(deckStart+Math.round((to-from)*(i/(float)span)));
+            if(pass==0&&StructureLevels.overlapsHistorical(level,state,at,1))return;
+            for(int k=-1;k<=1;k++){
+                var tile=at.relative(side,k);
+                if(pass==0){
+                    if(!level.hasChunkAt(tile)||!level.isEmptyBlock(tile.above())||!level.isEmptyBlock(tile.above(2)))return;
+                    if(i==0||i==span){if(!land(level,tile))return;}
+                    else if(!level.isEmptyBlock(tile)&&level.getFluidState(tile).isEmpty())return;
+                }else if(i>0&&i<span)level.setBlock(tile,Blocks.SPRUCE_PLANKS.defaultBlockState(),2);
+            }
+        }
+    }
+
+    private static boolean build(ServerLevel level,RelayState state,BlockPos middle,Direction axis) {
+        Direction side=axis.getClockWise();
+        BlockPos left=middle.relative(axis,-BANK), right=middle.relative(axis,BANK);
+        for(int i=-BANK;i<=BANK;i++) for(int k:new int[]{-WIDTH,WIDTH})
+            if(!level.hasChunkAt(middle.relative(axis,i).relative(side,k))) return false;
+        int from=height(level,left), to=height(level,right);
+        if(Math.abs(to-from)>BANK || (!street(level,left.atY(from)) && !street(level,right.atY(to)))) return false;
+        // Validate the full span before placing anything. Never cut buildings or open containers.
+        for(int i=-BANK;i<=BANK;i++){
+            int y=from+Math.round((to-from)*(i+BANK)/(2f*BANK));
+            var centre=middle.relative(axis,i).atY(y);
+            if(StructureLevels.overlapsHistorical(level,state,centre,WIDTH)) return false;
+            for(int k=-WIDTH;k<=WIDTH;k++){
+                var at=centre.relative(side,k);
+                var obstruction=level.getBlockState(at.above());
+                boolean curb=Math.abs(i)>=BANK-2 && obstruction.is(net.minecraft.tags.BlockTags.WALLS);
+                if((!obstruction.isAir()&&!curb)||!level.isEmptyBlock(at.above(2))) return false;
+                if(level.getBlockEntity(at)!=null) return false;
+                if(Math.abs(i)==BANK && !level.getBlockState(at).isSolidRender(level,at))return false;
+            }
+        }
+        for(int i=-BANK;i<=BANK;i++){
+            int y=from+Math.round((to-from)*(i+BANK)/(2f*BANK));
+            for(int k=-WIDTH;k<=WIDTH;k++){
+                var deck=middle.relative(axis,i).relative(side,k).atY(y);
+                if(level.getBlockState(deck.above()).is(net.minecraft.tags.BlockTags.WALLS))level.setBlock(deck.above(),Blocks.AIR.defaultBlockState(),2);
+                level.setBlock(deck,
+                (k==0?Blocks.LIGHT_GRAY_CONCRETE:Blocks.SMOOTH_STONE).defaultBlockState(),2);
+            }
+        }
+        return true;
+    }
+
+    private static int height(ServerLevel level,BlockPos at){
+        int top=level.getHeight(Heightmap.Types.MOTION_BLOCKING_NO_LEAVES,at.getX(),at.getZ())-1;
+        return level.getBlockState(at.atY(top)).is(net.minecraft.tags.BlockTags.WALLS)?top-1:top;
+    }
+
+    private static boolean street(ServerLevel level,BlockPos pos){
+        var block=level.getBlockState(pos);
+        return block.is(Blocks.GRAY_CONCRETE)||block.is(Blocks.WHITE_CONCRETE)||block.is(Blocks.LIGHT_GRAY_CONCRETE)
+            ||block.is(Blocks.SMOOTH_STONE)||block.is(Blocks.STONE_BRICKS)||block.is(Blocks.POLISHED_ANDESITE)
+            ||block.is(Blocks.STONE)||block.is(Blocks.ANDESITE)||block.is(Blocks.SMOOTH_STONE_SLAB);
+    }
+    private SectorCrossings(){}
+}
