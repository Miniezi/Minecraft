+package dev.bunkerrelay;
+
+import com.atsuishio.superbwarfare.entity.vehicle.base.VehicleEntity;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.levelgen.Heightmap;
+
+final class FieldTransport {
+    static void park(ServerLevel level,RelayState state,BlockPos origin){
+        long roll=RaidDirector.roll(state.seed,origin.getX(),origin.getZ()+811);
+        if(Math.floorMod(roll,100)>=58)return;
+        String id=switch(Math.floorMod(roll>>>12,5)){case 0->"ah_6";case 1,2->"truck";default->"sodayo_pick_up";};
+        var type=BuiltInRegistries.ENTITY_TYPE.get(ResourceLocation.parse("superbwarfare:"+id));
+        if(!(type.create(level) instanceof VehicleEntity vehicle))return;
+        for(int i=0;i<12;i++){
+            double angle=i*Math.PI/6;
+            int x=origin.getX()+(int)(35*Math.cos(angle)),z=origin.getZ()+(int)(35*Math.sin(angle));
+            var at=level.getHeightmapPos(Heightmap.Types.MOTION_BLOCKING_NO_LEAVES,new BlockPos(x,0,z));
+            if(!level.getBlockState(at.below()).isFaceSturdy(level,at.below(),net.minecraft.core.Direction.UP)
+                ||!level.canSeeSky(at))continue;
+            vehicle.moveTo(x+.5,at.getY()+.1,z+.5,(float)(angle*180/Math.PI),0);
+            if(!level.noCollision(vehicle))continue;
+            vehicle.getPersistentData().putInt("relay_structure_generation",state.generation+(state.generating?1:0));
+            vehicle.addTag("relay_vehicle");
+            vehicle.setEnergy(vehicle.getMaxEnergy());
+            level.addFreshEntity(vehicle);return;
+        }
+    }
+    private FieldTransport(){}
+}
