diff --git a/mod/src/main/java/dev/bunkerrelay/ExpeditionTerrain.java b/mod/src/main/java/dev/bunkerrelay/ExpeditionTerrain.java
new file mode 100644
index 0000000..3349e4f
--- /dev/null
+++ b/mod/src/main/java/dev/bunkerrelay/ExpeditionTerrain.java
@@ -0,0 +1,84 @@
+package dev.bunkerrelay;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.levelgen.Heightmap;
+
+/** Seeded surface relief. Store only the material and depth this pass added. */
+final class ExpeditionTerrain {
+    private static final Block[] SURFACES={Blocks.GRASS_BLOCK,Blocks.DIRT,Blocks.PODZOL,Blocks.COARSE_DIRT,
+        Blocks.SAND,Blocks.RED_SAND,Blocks.GRAVEL,Blocks.STONE,Blocks.TERRACOTTA,Blocks.SNOW_BLOCK,
+        Blocks.NETHERRACK,Blocks.BLACKSTONE,Blocks.BASALT,Blocks.MYCELIUM,Blocks.MOSS_BLOCK};
+
+    static void visit(ServerPlayer player,RelayState state){
+        if(!state.ready||state.generating)return;
+        var level=player.serverLevel();
+        var center=player.chunkPosition();
+        for(int radius=0;radius<=3;radius++)for(int dx=-radius;dx<=radius;dx++)for(int dz=-radius;dz<=radius;dz++){
+            if(Math.max(Math.abs(dx),Math.abs(dz))!=radius)continue;
+            if(shape(level,state,center.x+dx,center.z+dz))return;
+        }
+    }
+
+    static boolean shape(ServerLevel level,RelayState state,int cx,int cz){
+        if(!level.hasChunk(cx,cz)||!SectorPlan.contains(state.centerX,state.centerZ,state.activeSize,(cx<<4)+8,(cz<<4)+8))return false;
+        var chunk=level.getChunk(cx,cz);
+        String key="terrain61/"+level.dimension().location()+"/"+net.minecraft.world.level.ChunkPos.asLong(cx,cz);
+        var tag=state.roadChunks.getCompound(key);
+        if(tag.contains("seed")&&tag.getLong("seed")==state.seed)return false;
+        int mx=(cx<<4)+8,mz=(cz<<4)+8;
+        boolean protectedPlot=!chunk.getAllReferences().isEmpty()||!chunk.getBlockEntitiesPos().isEmpty();
+        for(int j=0;!protectedPlot&&state.layoutVersion==3&&j<ExpeditionGrid.PLOTS;j++){
+            var plot=ExpeditionGrid.point(state,j);
+            protectedPlot=Math.abs(mx-plot.getX())<64&&Math.abs(mz-plot.getZ())<64;
+        }
+        if(protectedPlot){
+            tag.putLong("seed",state.seed);state.roadChunks.put(key,tag);state.setDirty();return true;
+        }
+        int[] layers=tag.getIntArray("layers");
+        if(layers.length!=256)layers=new int[256];
+        boolean occupied=level.players().stream().anyMatch(p->Math.abs(p.getX()-((cx<<4)+8))<12&&Math.abs(p.getZ()-((cz<<4)+8))<12);
+        if(occupied)return false;
+        double phase=(state.seed&65535)*Math.PI/32768,phaseZ=((state.seed>>>16)&65535)*Math.PI/32768;
+        int amplitude=switch(state.activeTheme){case "winter","ash"->8;case "forest","hell"->6;default->4;};
+        for(int i=0;i<256;i++){
+            int x=(cx<<4)+(i&15),z=(cz<<4)+(i>>4);
+            int rx=x-state.centerX,rz=z-state.centerZ;
+            if(Math.max(Math.abs(rx),Math.abs(rz))<18||ExpeditionRoads.road(rx)||ExpeditionRoads.road(rz))continue;
+            int top=chunk.getHeight(Heightmap.Types.WORLD_SURFACE,x&15,z&15);
+            var pos=new BlockPos(x,top,z);
+            boolean snow=level.getBlockState(pos).is(Blocks.SNOW);
+            if(snow){pos=pos.below();top--;}
+            int old=layers[i],depth=old&15,material=0,base=top-depth;
+            if(depth>0){
+                material=(old>>>4)&15;
+                if(base!=(old>>8))continue;
+            }else{
+                while(material<SURFACES.length&&!level.getBlockState(pos).is(SURFACES[material]))material++;
+                if(material==SURFACES.length)continue;
+            }
+            Block surface=SURFACES[material];
+            Block fill=(surface==Blocks.GRASS_BLOCK||surface==Blocks.PODZOL||surface==Blocks.MOSS_BLOCK||surface==Blocks.MYCELIUM)?Blocks.DIRT:surface;
+            if(!level.getBlockState(pos).is(surface))continue;
+            boolean intact=true;
+            for(int y=1;y<depth;y++)if(!level.getBlockState(pos.below(y)).is(fill)){intact=false;break;}
+            if(!intact)continue;
+            double wave=Math.sin(rx*.072+phase)+Math.cos(rz*.058+phaseZ)+.45*Math.sin((rx+rz)*.11+phaseZ);
+            int target=(int)Math.round(Math.max(0,wave/2.45)*amplitude);
+            if(base+target+2>=level.getMaxBuildHeight()||target==depth)continue;
+            var snowState=level.getBlockState(pos.above());
+            if(snow)level.removeBlock(pos.above(),false);
+            for(int y=depth;y>target;y--)level.removeBlock(pos.atY(base+y),false);
+            for(int y=Math.max(1,depth);y<target;y++)level.setBlock(pos.atY(base+y),fill.defaultBlockState(),2);
+            level.setBlock(pos.atY(base+target),surface.defaultBlockState(),2);
+            if(snow)level.setBlock(pos.atY(base+target+1),snowState,2);
+            layers[i]=target==0?0:(base<<8)|(material<<4)|target;
+        }
+        if(java.util.Arrays.stream(layers).anyMatch(v->v!=0))tag.putIntArray("layers",layers);else tag.remove("layers");tag.putLong("seed",state.seed);
+        state.roadChunks.put(key,tag);state.setDirty();return true;
+    }
+    private ExpeditionTerrain(){}
+}
