@@ -0,0 +1,56 @@
+package dev.bunkerrelay;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.EquipmentSlot;
+import net.minecraft.world.item.*;
+import net.minecraft.world.item.component.CustomData;
+import net.minecraft.world.level.block.Blocks;
+
+final class ForgeRoom {
+    static final java.util.function.Supplier<Item> GEM=BossTrophies.ITEMS.register("forge_crystal",()->new Item(new Item.Properties().rarity(Rarity.RARE)));
+    static void register(){}
+    static boolean install(ServerPlayer p){
+        var level=p.server.getLevel(BunkerRelay.HUB);
+        var state=RelayState.get(p.server);
+        for(int x:new int[]{40,-40,64,-64})for(int z:new int[]{-24,-48,72}){
+            var o=new BlockPos(x,96,z);
+            boolean free=true;
+            for(int a=-4;a<=4&&free;a++)for(int b=-4;b<=4&&free;b++)for(int h=0;h<=4;h++)if(!level.isEmptyBlock(o.offset(a,h,b))){free=false;break;}
+            if(!free)continue;
+            for(int a=-4;a<=4;a++)for(int b=-4;b<=4;b++)for(int h=-1;h<=4;h++){
+                var block=h==-1?Blocks.POLISHED_ANDESITE:h==4?((a==0&&b==0)?Blocks.SEA_LANTERN:Blocks.DEEPSLATE_TILES):
+                    (Math.abs(a)==4||Math.abs(b)==4)&&!(b==4&&Math.abs(a)<=1&&h<3)?Blocks.STONE_BRICKS:Blocks.AIR;
+                level.setBlock(o.offset(a,h,b),block.defaultBlockState(),2);
+            }
+            level.setBlock(o,Blocks.SMITHING_TABLE.defaultBlockState(),2);
+            level.setBlock(o.west(2),Blocks.ANVIL.defaultBlockState(),2);
+            level.setBlock(o.east(2),Blocks.BLAST_FURNACE.defaultBlockState(),2);
+            state.structureLayouts.putLong("forgeBench",o.asLong());state.setDirty();return true;
+        }
+        return false;
+    }
+    static int rank(ItemStack s){return Math.clamp(s.getOrDefault(DataComponents.CUSTOM_DATA,CustomData.EMPTY).copyTag().getInt("relayForgeRank"),0,3);}
+    static boolean use(ServerPlayer p,BlockPos at){
+        var state=RelayState.get(p.server);
+        if(!p.level().dimension().equals(BunkerRelay.HUB)||!state.structureLayouts.contains("forgeBench")||at.asLong()!=state.structureLayouts.getLong("forgeBench"))return false;
+        var item=p.getMainHandItem();
+        if(!(item.getItem() instanceof com.tacz.guns.api.item.IGun||item.getItem() instanceof ArmorItem||item.getItem() instanceof SwordItem)||StarterKit.marked(item)){
+            RaidRules.tell(p,"Возьмите оружие или броню в основную руку и кристалл во вторую.");return true;
+        }
+        if(!p.getOffhandItem().is(GEM.get())){RaidRules.tell(p,"Нужен кузнечный кристалл во второй руке.");return true;}
+        int roll=p.getRandom().nextInt(100);
+        int tier=roll<55?1:roll<90?2:3;
+        String prefix=new String[]{"","Добротный","Отборный","Мастерский"}[tier];
+        var data=item.getOrDefault(DataComponents.CUSTOM_DATA,CustomData.EMPTY).copyTag();
+        if(!data.contains("relayForgeBase"))data.putString("relayForgeBase",item.getHoverName().getString());
+        data.putInt("relayForgeRank",tier);item.set(DataComponents.CUSTOM_DATA,CustomData.of(data));
+        item.set(DataComponents.RARITY,new Rarity[]{Rarity.COMMON,Rarity.UNCOMMON,Rarity.RARE,Rarity.EPIC}[tier]);
+        item.set(DataComponents.CUSTOM_NAME,Component.literal(prefix+" · "+data.getString("relayForgeBase")));
+        p.getOffhandItem().shrink(1);RelayEconomy.save(p);
+        RaidRules.tell(p,"Перековка · "+prefix+" · "+(item.getItem() instanceof ArmorItem?"защита +"+tier+"%":"урон +"+(tier*4)+"%"));return true;
+    }
+    private ForgeRoom(){}
+}
