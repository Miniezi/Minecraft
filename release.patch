@@ -0,0 +1,72 @@
+package dev.bunkerrelay;
+
+import com.mojang.authlib.GameProfile;
+import java.util.UUID;
+import net.minecraft.core.BlockPos;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.world.inventory.ClickType;
+import net.minecraft.world.level.block.Blocks;
+import net.neoforged.neoforge.common.util.FakePlayer;
+
+final class PolarIntegrationTest {
+    private static BlockPos entry;
+    private static long seed;
+    static void launch(MinecraftServer server,RelayState state){
+        var player=new FakePlayer(server.getLevel(BunkerRelay.HUB),new GameProfile(UUID.randomUUID(),"WinterTerminal"));
+        var terminal=HubBuilder.TERMINAL;
+        player.moveTo(terminal.getX(),terminal.getY(),terminal.getZ());
+        var menu=new TerminalMenu(12,player.getInventory(),player);
+        player.containerMenu=menu;
+        menu.clicked(22,0,ClickType.PICKUP,player);
+        menu.clicked(10+ZoneProfile.WINTER.ordinal(),0,ClickType.PICKUP,player);
+        menu.clicked(24,0,ClickType.PICKUP,player);
+        check(state.generating && state.activeTheme.equals("winter"),"terminal selection");
+    }
+
+    static void verify(MinecraftServer server,RelayState state){
+        var level=server.getLevel(BunkerRelay.key("polar_station"));
+        var arrival=new BlockPos(state.centerX,state.spawnY,state.centerZ);
+        check(state.activeDimension.equals("polar_station") && state.activeDifficulty==4 && state.activeLoot==4,"difficulty");
+        check(level.getBlockState(arrival).is(Blocks.LODESTONE),"extraction");
+        var rooms=RaidDirector.get(server).rooms.stream().filter(r->r.getString("type").equals("landmark")).toList();
+        check(rooms.size()==5,"five polar sites");
+        for(var room:rooms){
+            var at=new BlockPos(room.getInt("x"),room.getInt("y"),room.getInt("z"));
+            check(!PersonalLoot.templateItem(level,at,4).isEmpty(),"stocked landmark");
+            check(level.getBlockState(BlockPos.of(room.getLong("origin")).offset(-5,0,4)).is(Blocks.CAMPFIRE),"warming station");
+        }
+        if(entry!=null){
+            check(entry.equals(arrival) && seed!=state.seed,"same-place regeneration");
+            System.out.println("RELAY_POLAR_PASS terminal=true cold=true shelter=true heat=true loot=true live=true");
+            server.halt(false);
+            return;
+        }
+        var player=new FakePlayer(level,new GameProfile(UUID.randomUUID(),"WinterThermal"));
+        var sample=arrival.offset(6,0,6).atY(level.getMaxBuildHeight()-8);
+        player.moveTo(sample.getX()+.5,sample.getY(),sample.getZ()+.5);
+        var raid=new CompoundTag();
+        raid.putString("status","ACTIVE");raid.putInt("generation",state.generation);
+        RaidJournal.get(server).raids.put(player.getUUID(),raid);
+        try{
+            PolarCold.tick(player,state);
+            int exposed=raid.getInt("polarWarmth");
+            check(exposed>0 && exposed<100,"exposed");
+            level.setBlock(sample.above(2),Blocks.STONE.defaultBlockState(),3);
+            PolarCold.tick(player,state);
+            check(raid.getInt("polarWarmth")>exposed,"sheltered");
+            raid.putInt("polarWarmth",40);
+            level.setBlock(sample.east(),Blocks.CAMPFIRE.defaultBlockState(),3);
+            PolarCold.tick(player,state);
+            check(raid.getInt("polarWarmth")==50,"warm fire");
+        }finally{
+            RaidJournal.get(server).raids.remove(player.getUUID());
+            level.removeBlock(sample.above(2),false);level.removeBlock(sample.east(),false);
+        }
+        entry=arrival;seed=state.seed;
+        launch(server,state);
+    }
+
+    private static void check(boolean ok,String message){if(!ok)throw new IllegalStateException("Polar test: "+message);}
+    private PolarIntegrationTest(){}
+}
