--- /dev/null
+++ b/tools/factory_templates.py
@@ -0,0 +1,29 @@
+"""Generate vanilla structure NBT for the three Relay Factories workshops."""
+from pathlib import Path
+import gzip, struct
+out = Path(__file__).resolve().parents[1]/'mod/src/relayFactories/resources/data/relayfactories/structure'
+out.mkdir(parents=True,exist_ok=True)
+def integer(i):return struct.pack('>i',i)
+def string(s):return struct.pack('>H',len(s.encode()))+s.encode()
+def tag(t,n,v):return bytes([t])+string(n)+v
+def array(t,items):return bytes([t])+integer(len(items))+b''.join(items)
+def ints(seq):return array(3,[integer(i) for i in seq])
+for name,w,l,wall,station in [('foundry',33,27,'bricks','blast_furnace'),('assembly',27,37,'gray_concrete','piston'),('arsenal',31,23,'polished_deepslate','smithing_table')]:
+ blocks={};palette=[]
+ def put(x,y,z,material):
+  if material not in palette:palette.append(material)
+  blocks[x,y,z]=palette.index(material)
+ for x in range(w):
+  for z in range(l):
+   put(x,0,z,'smooth_stone')
+   edge=x in (0,w-1) or z in (0,l-1)
+   for y in range(1,9):
+    material='air'
+    if y==8:material='iron_block' if x%8==0 else 'smooth_stone'
+    elif edge and not (z==0 and abs(x-w//2)<=2 and y<=4):material='glass' if y in (4,5) and x%6 and z%6 else wall
+    elif y==1 and 3<x<w-3 and x%8 in (1,2) and z%7 in (2,3):material=station
+    elif x%8==0 and z in (2,l-3):material='iron_block'
+    elif y==7 and x%8==0 and z%8==0:material='sea_lantern'
+    put(x,y,z,material)
+ content=tag(3,'DataVersion',integer(3955))+tag(9,'size',ints([w,9,l]))+tag(9,'palette',array(10,[tag(8,'Name',string('minecraft:'+v))+b'\0' for v in palette]))+tag(9,'blocks',array(10,[tag(9,'pos',ints(pos))+tag(3,'state',integer(v))+b'\0' for pos,v in blocks.items()]))+tag(9,'entities',array(10,[]))+b'\0'
+ (out/(name+'.nbt')).write_bytes(gzip.compress(tag(10,'',content),mtime=0))
