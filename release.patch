diff --git a/mod/src/main/java/dev/bunkerrelay/SiteCrate.java b/mod/src/main/java/dev/bunkerrelay/SiteCrate.java
new file mode 100644
index 0000000..e17e357
--- /dev/null
+++ b/mod/src/main/java/dev/bunkerrelay/SiteCrate.java
@@ -0,0 +1,64 @@
+package dev.bunkerrelay;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.level.block.entity.BaseContainerBlockEntity;
+import net.minecraft.world.level.block.entity.ChestBlockEntity;
+
+enum SiteCrate {
+    DRESSINGS("Перевязочный шкаф",Items.WHITE_WOOL,Items.STRING),
+    PHARMACY("Аптечный шкаф",Items.GLASS_BOTTLE,Items.HONEY_BOTTLE),
+    LAB("Контейнер лабораторных проб",Items.SPIDER_EYE,Items.GLASS_BOTTLE),
+    FOUNDRY("Ящик литейщика",Items.RAW_IRON,Items.CHARCOAL),
+    ASSEMBLY("Ящик сборщика",Items.PISTON,Items.IRON_NUGGET),
+    ELECTRICAL("Электромонтажный ящик",Items.COPPER_INGOT,Items.REPEATER),
+    ARMORER("Ящик оружейника",Items.IRON_INGOT,Items.FLINT),
+    QUARTERMASTER("Ящик интенданта",Items.LEATHER,Items.CHAIN),
+    ARCHIVE("Архивный ящик",Items.PAPER,Items.BOOK),
+    FIELD("Полевое снаряжение",Items.TORCH,Items.LEAD),
+    RATIONS("Ящик сухпайков",Items.DRIED_KELP,Items.COOKED_BEEF),
+    MINE("Ящик шахтёра",Items.COAL,Items.IRON_PICKAXE);
+
+    final String title;
+    private final Item first;
+    private final Item second;
+
+    SiteCrate(String title,Item first,Item second){
+        this.title=title;
+        this.first=first;
+        this.second=second;
+    }
+
+    static SiteCrate select(String template,SupplySites.Kind kind,boolean clinic,boolean alternate){
+        if(clinic)return alternate?PHARMACY:DRESSINGS;
+        if(template.equals("lab")||template.contains("biomass"))return LAB;
+        if(template.contains("foundry"))return FOUNDRY;
+        if(template.contains("assembly"))return alternate?ELECTRICAL:ASSEMBLY;
+        if(template.contains("mine"))return MINE;
+        if(template.contains("library")||template.contains("cartographer"))return ARCHIVE;
+        return switch(kind){
+            case ARMORY -> alternate?ARMORER:QUARTERMASTER;
+            case FACTORY -> alternate?ASSEMBLY:ELECTRICAL;
+            case CANTEEN -> RATIONS;
+            case WAREHOUSE -> alternate?FIELD:ARCHIVE;
+        };
+    }
+
+    void finish(ServerLevel level,BlockPos at,ChestBlockEntity chest,RelayState state){
+        var random=RandomSource.create(state.seed^at.asLong());
+        chest.setItem(18,new ItemStack(first,1+random.nextInt(3)));
+        chest.setItem(19,new ItemStack(second,Math.min(second.getDefaultMaxStackSize(),1+random.nextInt(2))));
+        if(this==DRESSINGS)chest.setItem(20,new ItemStack(Medicine.BANDAGE.get(),2));
+        if(this==PHARMACY && state.activeLoot>=3)chest.setItem(20,new ItemStack(Medicine.MEDKIT.get()));
+        PersonalLoot.convert(level,at,chest);
+        if(level.getBlockEntity(at) instanceof BaseContainerBlockEntity personal){
+            var tag=personal.saveWithoutMetadata(level.registryAccess()); tag.putString("CustomName",Component.Serializer.toJson(Component.literal(title),level.registryAccess())); personal.loadWithComponents(tag,level.registryAccess());
+            personal.setChanged();
+        }
+    }
+}
