@@ -0,0 +1,43 @@
+package dev.bunkerrelay;
+
+import net.minecraft.core.BlockPos;
+import net.minecraft.network.chat.Component;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.properties.BlockStateProperties;
+
+final class PolarCold {
+    static void tick(ServerPlayer player,RelayState state){
+        if(!state.ready || state.generating || !state.activeTheme.equals("winter") ||
+            !player.level().dimension().equals(BunkerRelay.key("polar_station")) ||
+            player.isCreative() || player.isSpectator() || !RaidRules.active(player))return;
+        var raid=RaidRules.record(player);
+        if(!raid.getString("status").equals("ACTIVE") || raid.getInt("generation")!=state.generation)return;
+        var level=player.serverLevel();
+        int before=raid.contains("polarWarmth")?raid.getInt("polarWarmth"):100;
+        boolean heater=false;
+        var feet=player.blockPosition();
+        for(var pos:BlockPos.betweenClosed(feet.offset(-2,-1,-2),feet.offset(2,1,2))){
+            var block=level.getBlockState(pos);
+            if((block.is(Blocks.CAMPFIRE)||block.is(Blocks.FURNACE)||block.is(Blocks.SMOKER))
+                && block.getValue(BlockStateProperties.LIT)){heater=true;break;}
+        }
+        int leather=0;
+        for(var piece:player.getArmorSlots()){
+            if(piece.is(Items.LEATHER_BOOTS)||piece.is(Items.LEATHER_LEGGINGS)||
+                piece.is(Items.LEATHER_CHESTPLATE)||piece.is(Items.LEATHER_HELMET))leather++;
+        }
+        boolean sheltered=level.getHeight(net.minecraft.world.level.levelgen.Heightmap.Types.MOTION_BLOCKING_NO_LEAVES,feet.getX(),feet.getZ())>feet.getY()+1;
+        int change=heater?10:player.isInWater()?-7:sheltered?3:
+            -Math.max(1,3+(level.isNight()?2:0)+(level.isRaining()?1:0)-leather);
+        int warmth=Math.clamp(before+change,0,100);
+        raid.putInt("polarWarmth",warmth);
+        if(before!=warmth)RaidJournal.get(player.server).setDirty();
+        if(warmth<=10)player.hurt(player.damageSources().freeze(),1f);
+        if(before/10!=warmth/10 || warmth<=10)player.displayClientMessage(Component.literal(
+            "Тепло · "+warmth+"% · "+(heater?"обогрев":player.isInWater()?"ледяная вода":sheltered?"укрытие":"мороз")),true);
+    }
+
+    private PolarCold(){}
+}
